<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="eyebrow-line"></span>{{ d.eyebrow }}</p>
    <h1 id="hero-title">{{ d.heroTitle | safe }}</h1>
    <p class="hero-lead">{{ d.heroText }}</p>
    <div class="hero-actions"><a class="button button-primary" href="#contact">{{ d.heroCta }}</a><a class="text-link" href="#services">{{ d.heroSecondary }} <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="hero-visual" aria-label="{{ d.visualLabel }}: {{ d.visualInput }}, {{ d.visualMiddle }}, {{ d.visualOutput }}" role="img">
    <div class="visual-top"><span class="visual-company">Think &amp; Solve Different Solutions (FZE)</span><span>{{ d.visualLabel }}</span></div>
    <div class="visual-path">
      <div class="path-row"><span class="path-index">01</span><span class="path-node">{{ d.visualInput }}</span><span class="path-line"></span></div>
      <div class="path-row active"><span class="path-index">02</span><span class="path-node">{{ d.visualMiddle }}</span><span class="path-line"></span></div>
      <div class="path-row"><span class="path-index">03</span><span class="path-node">{{ d.visualOutput }}</span><span class="path-line"></span></div>
    </div>
    <div class="visual-bottom"><span class="visual-grid-icon" aria-hidden="true">✳</span><span>{{ d.heroNote }}</span></div>
  </div>
</section>

<section class="section section-services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-heading section-heading-split"><div><p class="eyebrow dark"><span class="eyebrow-line"></span>{{ d.introEyebrow }}</p><h2 id="services-title">{{ d.introTitle }}</h2></div><p>{{ d.introText }}</p></div>
    <div class="service-grid">
      {% for service in d.services %}
      <article class="service-card"><span class="card-tag">{{ service.tag }}</span><div class="card-accent" aria-hidden="true"><span></span><span></span><span></span></div><h3>{{ service.title }}</h3><p>{{ service.text }}</p><div class="card-detail">{{ service.detail }}</div></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section approach-section" id="approach" aria-labelledby="approach-title">
  <div class="container approach-layout"><div class="approach-intro"><p class="eyebrow dark"><span class="eyebrow-line"></span>{{ d.approachEyebrow }}</p><h2 id="approach-title">{{ d.approachTitle }}</h2><p>{{ d.approachText }}</p></div><div class="steps">{% for step in d.steps %}<div class="step"><span class="step-number">0{{ loop.index }}</span><div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></div>{% endfor %}</div></div>
</section>

<section class="section about-section" id="about" aria-labelledby="about-title">
  <div class="container about-layout"><div><p class="eyebrow dark"><span class="eyebrow-line"></span>{{ d.aboutEyebrow }}</p><h2 id="about-title">{{ d.aboutTitle }}</h2></div><div class="about-text"><p>{{ d.aboutCompany }}</p><p>{{ d.aboutPerson }}</p><a class="text-link" href="{{ d.personalUrl }}" target="_blank" rel="noopener noreferrer">{{ d.personalLink }} <span aria-hidden="true">↗</span></a></div></div>
</section>

<section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container contact-inner"><div><p class="eyebrow"><span class="eyebrow-line"></span>{{ d.contactEyebrow }}</p><h2 id="contact-title">{{ d.contactTitle }}</h2><p>{{ d.contactText }}</p></div><div class="contact-actions"><a class="button button-light email-link" href="mailto:ibrahim.yildiz@thinksolveconsulting.com?subject=Think%20%26%20Solve%20Different%20Solutions%20%E2%80%94%20Consulting%20inquiry"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5.5h18v13H3zM4 7l8 6 8-6"/></svg><span>{{ d.contactCta }}</span></a><a href="https://www.linkedin.com/company/think-solve-different-solutions-fze" target="_blank" rel="noopener noreferrer">{{ d.contactAlternative }} <span aria-hidden="true">↗</span></a></div></div></section>
